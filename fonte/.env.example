# ==========================================
# Batalha do Estreito 2.0 — Variáveis de Ambiente
# ==========================================
# Copie este arquivo para .env e preencha os valores

# Porta do servidor
PORT=3000

# Segredo para geração de tokens JWT
# ⚠️ OBRIGATÓRIO em produção! Gere com:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE_AQUI_chave_secreta_forte_2026

# Ambiente (development / production)
NODE_ENV=development

# Comissão da casa sobre apostas (em %)
HOUSE_COMMISSION_PERCENT=10

# Bônus diário de moedas para novos logins
DAILY_BONUS_AMOUNT=200

# Saldo inicial de moedas para novos jogadores
INITIAL_COINS=1000

# ==========================================
# SEGURANÇA (configurar em produção)
# ==========================================

# Origens permitidas para CORS (separadas por vírgula)
# Em desenvolvimento, deixar em branco (localhost é liberado automaticamente)
# Em produção, definir seu domínio: https://seudominio.com.br
ALLOWED_ORIGINS=https://seudominio.com.br

# IDs dos usuários administradores (separados por vírgula)
# Necessário para acessar /api/admin/revenue
ADMIN_USER_IDS=1
