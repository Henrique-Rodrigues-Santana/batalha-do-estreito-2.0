# ==========================================
# Batalha do Estreito 2.0 — Variáveis de Ambiente
# ==========================================
# Copie este arquivo para .env e preencha os valores

# Porta do servidor
PORT=3000

# Segredo para geração de tokens JWT (TROQUE PARA UMA CHAVE FORTE!)
JWT_SECRET=TROQUE_AQUI_chave_secreta_forte_2026

# Ambiente (development / production)
NODE_ENV=development

# Comissão da casa sobre apostas (em %)
HOUSE_COMMISSION_PERCENT=10

# Bônus diário de moedas para novos logins
DAILY_BONUS_AMOUNT=200

# Saldo inicial de moedas para novos jogadores
INITIAL_COINS=1000
